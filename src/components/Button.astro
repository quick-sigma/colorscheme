---
export interface Props {
  label: string;
  icon: string;
  href?: string;
}

const { label, icon, href } = Astro.props;

const ICON_BODIES: Record<string, string> = {
  "lucide:image":
    '<g fill="none" stroke="url(#icon-gradient)" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></g>',
  "lucide:droplet":
    '<path fill="none" stroke="url(#icon-gradient)" stroke-linecap="round" stroke-linejoin="round" d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5S5 13 5 15a7 7 0 0 0 7 7"/>',
};

const body = ICON_BODIES[icon] ?? ICON_BODIES["lucide:image"];
---

<a href={href || undefined} class="action-btn" role={href ? undefined : "button"} tabindex={href ? undefined : 0}>
  <div class="icon-wrapper">
    <svg viewBox="0 0 24 24" fill="none" class="btn-icon">
      <defs>
        <linearGradient id="icon-gradient" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#6366f1" />
          <stop offset="100%" stop-color="#a855f7" />
        </linearGradient>
      </defs>
      <Fragment set:html={body} />
    </svg>
  </div>
  <span class="btn-label">{label}</span>
</a>

<style>
  .action-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    width: 160px;
    height: 160px;
    border: 2px solid rgba(255, 255, 255, 0.15);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.03);
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 1.5rem;
    backdrop-filter: blur(4px);
    text-decoration: none;
    color: inherit;
  }

  .action-btn:hover {
    border-color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.08);
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .action-btn:active {
    transform: translateY(0);
  }

  .icon-wrapper {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .btn-icon {
    width: 100%;
    height: 100%;
    stroke-width: 1.5;
  }

  .btn-label {
    font-family: "Inter", system-ui, sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
    letter-spacing: 0.02em;
    text-transform: lowercase;
  }
</style>
