---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
---

<BaseLayout>
  <div class="buttons-row">
    <Button label="imagen" icon="lucide:image" href="/extractor" />
    <Button label="color picker" icon="lucide:droplet" href="/picker" />
  </div>
</BaseLayout>

<style>
  body {
    overflow: hidden;
  }

  .buttons-row {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3rem;
    flex-wrap: wrap;
  }
</style>
