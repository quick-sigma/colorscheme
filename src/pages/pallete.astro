    const hexBgD = hx(bgD.r, bgD.g, bgD.b);
    const hexTxD = hx(txD.r, txD.g, txD.b);

    const extras = [hexBgL, null, hexTxL, null, hexBgD, null, hexTxD, null, null, null];

    let html = '<div class="p-container"><div class="p-grid">';
    for (let ri = 0; ri < ROLE_NAMES.length; ri++) {
      html += `<div class="p-label">${ROLE_NAMES[ri]}</div>`;
    }
    html += '<div class="p-label p-label-e">Base</div>';
    for (let row = 0; row < OFFS.length; row++) {
      const shade = sh[row];
      for (const role of ROLES) {
        const rh = roleH(shade.h, shade.s, shade.l, role);
        const rgb = hslToRgb(rh.h, rh.s, rh.l);
        const c = hx(rgb.r, rgb.g, rgb.b);
        html += `<div class="p-cell" style="background:${c};color:${contrast(rgb.r,rgb.g,rgb.b)}">${c.toUpperCase()}</div>`;
      }
      const ex = extras[row];
      if (ex) {
        const er = parseHex(ex);
        html += `<div class="p-cell" style="background:${ex};color:${contrast(er.r,er.g,er.b)}">${ex.toUpperCase()}</div>`;
      } else {
        html += `<div class="p-cell p-empty"></div>`;
      }
    }
    html += '</div></div>';
    root.innerHTML = html;

    const roleColors = [
      getBaseColor(sh, ROLES[0], 4),
      getBaseColor(sh, ROLES[1], 4),
      getBaseColor(sh, ROLES[2], 4),
      getBaseColor(sh, ROLES[3], 4),
      getBaseColor(sh, ROLES[4], 4),
      getBaseColor(sh, ROLES[5], 4),
    ];

    const suggestions = {
      bgLight: hexBgL,
      textLight: hexTxL,
      bgDark: hexBgD,
      textDark: hexTxD,
    };

    const btn = document.getElementById("dropdown-btn");
    const panel = document.getElementById("dropdown-panel");
    const title = document.getElementById("dropdown-title");
    const sub = document.getElementById("dropdown-sub");

    const savedIdx = parseInt(localStorage.getItem("palTemplateIdx")) || 0;
    const tpl = TEMPLATES[savedIdx];
    if (tpl) {
      title.textContent = tpl.name;
      sub.textContent = tpl.subtitle;
      panel.querySelectorAll(".dropdown-option").forEach((o) => o.classList.remove("active"));
      const activeOpt = panel.querySelector(`.dropdown-option[data-idx="${savedIdx}"]`);
      if (activeOpt) activeOpt.classList.add("active");
    }
    renderPreview(savedIdx, roleColors, suggestions);

    btn._roleColors = roleColors;
    btn._suggestions = suggestions;

    const secPanel = document.getElementById("sec-panel");
    const secBtnDot = document.getElementById("sec-btn-dot");
    const secBtnLabel = document.getElementById("sec-btn-label");
    if (secPanel) {
      const secColor = roleColors[1];
      if (secBtnDot) secBtnDot.style.background = secColor;
      const offName = suggLabels[secOff] || secOff + "°";
      if (secBtnLabel) secBtnLabel.textContent = offName;

      const suggs = [
        { off: 30, label: "Análogo +30°" },
        { off: -30, label: "Análogo −30°" },
        { off: 60, label: "Diada 60°" },
        { off: 120, label: "Triada 120°" },
        { off: 240, label: "Triada 240°" },
        { off: 150, label: "Comp. dividido 150°" },
        { off: 210, label: "Comp. dividido 210°" },
        { off: 180, label: "Complemento 180°" },
      ];
      let sh = "";
      for (const sg of suggs) {
        const off = sg.off;
        const targetH = (h + off + 360) % 360;
        const rgb = hslToRgb(targetH, s, l);
        const c = hx(rgb.r, rgb.g, rgb.b);
        const active = off === secOff ? " active" : "";
        sh += `<button class="sec-sug${active}" data-off="${off}"><span class="ss-dot" style="background:${c}"></span><span class="ss-lbl">${sg.label}</span></button>`;
      }
      secPanel.innerHTML = sh;
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    const lastNav = localStorage.getItem("palLastNav");
    const backBtn = document.querySelector(".back-btn");
    if (lastNav && backBtn) {
      backBtn.href = "/" + lastNav;
    }

    build();

    const colorPicker = document.getElementById("color-input");
    const colorHex = document.getElementById("color-hex");
    const genBtn = document.getElementById("generate-btn");
    const defaultHex = new URLSearchParams(location.search).get("hex") || "ff0000";
    colorPicker.value = "#" + defaultHex;
    colorHex.value = "#" + defaultHex.toUpperCase();

    function getClean() {
      return colorHex.value.replace("#", "").toLowerCase();
    }

    colorPicker.addEventListener("input", () => {
      colorHex.value = colorPicker.value.toUpperCase();
    });

    colorHex.addEventListener("change", () => {
      const v = colorHex.value.trim();
      if (/^#[0-9a-f]{6}$/i.test(v)) colorPicker.value = v.toLowerCase();
    });

    genBtn.addEventListener("click", () => {
      const s = new URLSearchParams(location.search).get("s") || 120;
      location.search = "?hex=" + getClean() + "&s=" + s;
    });

    const exportBtn = document.getElementById("export-btn");
    const exportOverlay = document.getElementById("export-overlay");
    const exportClose = document.getElementById("export-close");
    const exportBack = document.getElementById("export-back");
    const exportGrid = document.getElementById("export-grid");
    const exportCode = document.getElementById("export-code");
    const exportPre = document.getElementById("export-pre");
    const exportCodeContent = document.getElementById("export-code-content");
    const exportCopy = document.getElementById("export-copy");

    function closeExport() { exportOverlay.classList.add("hidden"); }

    function showCode(content, lang) {
      exportGrid.classList.add("hidden");
      exportCode.classList.remove("hidden");
      exportBack.classList.remove("hidden");
      exportCodeContent.textContent = content;
      exportPre.className = lang || "";
    }

    exportBtn.addEventListener("click", () => {
      exportGrid.classList.remove("hidden");
      exportCode.classList.add("hidden");
      exportBack.classList.add("hidden");
      exportOverlay.classList.remove("hidden");
    });

    exportClose.addEventListener("click", closeExport);
    exportBack.addEventListener("click", () => {
      exportGrid.classList.remove("hidden");
      exportCode.classList.add("hidden");
      exportBack.classList.add("hidden");
    });

    exportOverlay.addEventListener("click", (e) => { if (e.target === exportOverlay) closeExport(); });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !exportOverlay.classList.contains("hidden")) closeExport();
    });

    exportCopy.addEventListener("click", () => {
      navigator.clipboard.writeText(exportCodeContent.textContent).then(() => {
        exportCopy.textContent = "¡Copiado!";
        setTimeout(() => { exportCopy.textContent = "Copiar al portapapeles"; }, 2000);
      });
    });

    function getExportCells() {
      const root = document.getElementById("pal-root");
      const grid = root.querySelector(".p-grid");
      if (!grid) return [];
      return [...grid.querySelectorAll(".p-cell:not(.p-empty)")];
    }

    function getExportLabels() {
      const root = document.getElementById("pal-root");
      const grid = root.querySelector(".p-grid");
      if (!grid) return [];
      return [...grid.querySelectorAll(".p-label")];
    }

    exportOverlay.addEventListener("click", (e) => {
      const opt = e.target.closest(".export-opt");
      if (!opt) return;
      const fmt = opt.dataset.fmt;
      const labels = getExportLabels();
      const cells = getExportCells();

      if (fmt === "png") {
        const swatchW = 110, swatchH = 50, cols = 7, gap = 3, pad = 14;
        const totalW = cols * swatchW + (cols - 1) * gap + pad * 2;
        const rows = Math.ceil(cells.length / cols);
        const totalH = rows * swatchH + (rows - 1) * gap + pad * 2;
        const cnv = document.createElement("canvas");
        cnv.width = totalW; cnv.height = totalH;
        const ctx = cnv.getContext("2d");
        ctx.fillStyle = "#1a1a1e"; ctx.fillRect(0, 0, totalW, totalH);
        cells.forEach((el, i) => {
          const col = i % cols, row = Math.floor(i / cols);
          const x = pad + col * (swatchW + gap), y = pad + row * (swatchH + gap);
          const hex = "#" + el.textContent.trim().replace("#", "");
          ctx.fillStyle = hex; ctx.fillRect(x, y, swatchW, swatchH);
          ctx.fillStyle = getComputedStyle(el).color;
          ctx.font = "bold 10px Inter, sans-serif";
          ctx.fillText(hex.toUpperCase(), x + 5, y + 13);
        });
        const a = document.createElement("a");
        a.download = "palette.png"; a.href = cnv.toDataURL(); a.click();
        closeExport();
        return;
      }

      if (fmt === "css") {
        const names = labels.map((l) => l.textContent.trim().toLowerCase().replace(/[^a-z0-9]/g, "-"));
        const lines = [":root {"];
        cells.forEach((el, i) => {
          const hex = el.textContent.trim().toLowerCase();
          if (!hex) return;
          const col = i % 7;
          const row = Math.floor(i / 7);
          const role = names[col] || "color";
          const shade = ((row + 1) * 100).toString();
          lines.push(`  --${role}-${shade}: ${hex};`);
        });
        lines.push("}");
        showCode(lines.join("\n"), "language-css");
        return;
      }

      if (fmt === "tailwind") {
        const roleNames = labels.map((l) => l.textContent.trim().toLowerCase().replace(/[^a-z0-9]/g, "-"));
        const colors = {};
        cells.forEach((el, i) => {
          const col = i % 7, row = Math.floor(i / 7);
          const name = roleNames[col] || "c" + col;
          if (!colors[name]) colors[name] = {};
          colors[name][Math.min((row + 1) * 100, 900)] = el.textContent.trim().toLowerCase();
        });
        showCode(JSON.stringify({ theme: { extend: { colors } } }, null, 2), "language-json");
        return;
      }

      if (fmt === "prompt") {
        const roleNames = labels.map((l) => l.textContent.trim());
        const lines = ["Generá una interfaz de usuario usando esta paleta de colores:"];
        let si = 0;
        const groups = {};
        cells.forEach((el) => {
          const col = si % 7;
          const name = roleNames[col] || "Color";
          if (!groups[name]) groups[name] = [];
          groups[name].push(el.textContent.trim());
          si++;
        });
        for (const [name, colors] of Object.entries(groups)) {
          if (name === "Base") continue;
          lines.push(`- ${name}: ${colors.slice(0, 5).join(", ")}...`);
        }
        lines.push("\nUsá estos colores como variables CSS mapeadas a los roles del sistema de diseño. Creá un layout de página completo con header, hero, secciones y footer.");
        showCode(lines.join("\n"), "");
        return;
      }
    });

    const secBtn = document.getElementById("sec-btn");
    const secPanel = document.getElementById("sec-panel");
    if (secBtn && secPanel) {
      secBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        secPanel.classList.toggle("hidden");
        secBtn.classList.toggle("open");
      });
      document.addEventListener("click", () => {
        if (!secPanel.classList.contains("hidden")) {
          secPanel.classList.add("hidden");
          secBtn.classList.remove("open");
        }
      });
      secPanel.addEventListener("click", (e) => {
        const btn = e.target.closest(".sec-sug");
        if (!btn) return;
        const off = parseInt(btn.dataset.off);
        const hex = new URLSearchParams(location.search).get("hex") || "ff0000";
        location.search = "?hex=" + hex + "&s=" + off;
      });
    }

    const left = document.querySelector(".pal-left");
    const resizer = document.getElementById("resizer");
    let rLeft = parseInt(localStorage.getItem("palLeftWidth")) || 30;
    left.style.width = rLeft + "%";

    resizer.addEventListener("mousedown", (e) => {
      e.preventDefault();
      resizer.classList.add("dragging");
      const page = document.querySelector(".pal-page");
      const startX = e.clientX;
      const startW = rLeft;

      function onMove(ev) {
        const dx = ev.clientX - startX;
        const pct = startW + (dx / page.offsetWidth) * 100;
        rLeft = Math.max(15, Math.min(60, pct));
        left.style.width = rLeft + "%";
      }

      function onUp() {
        resizer.classList.remove("dragging");
        localStorage.setItem("palLeftWidth", rLeft);
        document.removeEventListener("mousemove", onMove);
        document.removeEventListener("mouseup", onUp);
      }

      document.addEventListener("mousemove", onMove);
      document.addEventListener("mouseup", onUp);
    });

    const btn = document.getElementById("dropdown-btn");
    const panel = document.getElementById("dropdown-panel");
    const arrow = btn.querySelector(".dropdown-arrow");

    function openPanel() {
      panel.classList.remove("hidden", "drawer-close");
      panel.classList.add("drawer-open");
      arrow.style.transform = "rotate(180deg)";
    }

    function closePanel() {
      panel.classList.remove("drawer-open");
      panel.classList.add("drawer-close");
      arrow.style.transform = "";
      setTimeout(() => {
        panel.classList.add("hidden");
        panel.classList.remove("drawer-close");
      }, 150);
    }

    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      if (panel.classList.contains("hidden")) {
        openPanel();
      } else {
        closePanel();
      }
    });

    document.addEventListener("click", () => {
      if (!panel.classList.contains("hidden")) closePanel();
    });

    panel.addEventListener("click", (e) => {
      const opt = e.target.closest(".dropdown-option");
      if (!opt || opt.classList.contains("active")) return;
      const idx = parseInt(opt.dataset.idx);
      panel.querySelectorAll(".dropdown-option").forEach((o) => o.classList.remove("active"));
      opt.classList.add("active");
      closePanel();
      const tpl = TEMPLATES[idx];
      document.getElementById("dropdown-title").textContent = tpl.name;
      document.getElementById("dropdown-sub").textContent = tpl.subtitle;
      localStorage.setItem("palTemplateIdx", idx);
      renderPreview(idx, btn._roleColors, btn._suggestions);
    });
  });

  document.addEventListener("click", (e) => {
    const cell = e.target.closest(".p-cell");
    if (!cell || cell.classList.contains("p-empty")) return;
    const hex = cell.textContent.trim();
    const parsed = parseHex(hex);
    if (!parsed) return;
    const hexFull = hex.startsWith("#") ? hex : "#" + hex;
    navigator.clipboard.writeText(hexFull).catch(() => {});
    const orig = cell.textContent;
    cell.textContent = "Copiado!";
    cell.style.fontSize = "0.55rem";
    setTimeout(() => {
      cell.textContent = orig;
      cell.style.fontSize = "";
    }, 600);
  });
</script>

