.btn{font-family:'IBM Plex Mono',monospace;font-size:0.82rem;padding:13px 22px;border-radius:2px;text-decoration:none;transition:background .2s}
.btn-primary{background:var(--ink);color:var(--wall);border:1px solid var(--ink)}
