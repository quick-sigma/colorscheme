        </button>
      </div>
      <div id="export-code" class="export-code hidden">
        <pre id="export-pre"><code id="export-code-content"></code></pre>
        <button id="export-copy" class="export-copy-btn">Copiar al portapapeles</button>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function hx(r, g, b) {
    return "#" + [r, g, b].map((x) => x.toString(16).padStart(2, "0")).join("");
  }

  function parseHex(h) {
    h = h.replace("#", "").trim();
    if (!h) return null;
    if (h.length === 3) h = h[0] + h[0] + h[1] + h[1] + h[2] + h[2];
    if (h.length !== 6) return null;
    const r = parseInt(h.substring(0, 2), 16);
    const g = parseInt(h.substring(2, 4), 16);
    const b = parseInt(h.substring(4, 6), 16);
    if (isNaN(r) || isNaN(g) || isNaN(b)) return null;
    return { r, g, b };
  }

  function rgbToHsl(r, g, b) {
    r /= 255; g /= 255; b /= 255;
    const mx = Math.max(r, g, b), mn = Math.min(r, g, b);
    let h = 0, s = 0, l = (mx + mn) / 2;
    const d = mx - mn;
    if (d !== 0) {
      s = l > 0.5 ? d / (2 - mx - mn) : d / (mx + mn);
      if (mx === r) h = ((g - b) / d + (g < b ? 6 : 0)) * 60;
      else if (mx === g) h = ((b - r) / d + 2) * 60;
      else h = ((r - g) / d + 4) * 60;
    }
    return { h: Math.round(h), s: Math.round(s * 100), l: Math.round(l * 100) };
  }

  function hslToRgb(h, s, l) {
    s = Math.max(0, Math.min(100, s));
    l = Math.max(0, Math.min(100, l));
    s /= 100; l /= 100;
    const c = (1 - Math.abs(2 * l - 1)) * s;
    const x = c * (1 - Math.abs(((h / 60) % 2) - 1));
    const m = l - c / 2;
    let r, g, b;
    if (h < 60) { r = c; g = x; b = 0; }
    else if (h < 120) { r = x; g = c; b = 0; }
    else if (h < 180) { r = 0; g = c; b = x; }
    else if (h < 240) { r = 0; g = x; b = c; }
    else if (h < 300) { r = x; g = 0; b = c; }
    else { r = c; g = 0; b = x; }
    return {
      r: Math.round((r + m) * 255),
      g: Math.round((g + m) * 255),
      b: Math.round((b + m) * 255),
    };
  }

  function lighten(hex, amount) {
    const p = parseHex(hex);
    if (!p) return hex;
    const hsl = rgbToHsl(p.r, p.g, p.b);
    hsl.l = Math.min(97, hsl.l + amount);
    const rgb = hslToRgb(hsl.h, hsl.s, hsl.l);
    return hx(rgb.r, rgb.g, rgb.b);
  }

  function darken(hex, amount) {
    const p = parseHex(hex);
    if (!p) return hex;
    const hsl = rgbToHsl(p.r, p.g, p.b);
    hsl.l = Math.max(3, hsl.l - amount);
    const rgb = hslToRgb(hsl.h, hsl.s, hsl.l);
    return hx(rgb.r, rgb.g, rgb.b);
  }

  function toRgba(hex, a) {
    const p = parseHex(hex);
    if (!p) return hex;
    return `rgba(${p.r},${p.g},${p.b},${a})`;
  }

  const ROLE_NAMES = ["Primario", "Secundario", "Info", "Advertencia", "Error", "Éxito"];

  const suggLabels = {
    30: "Análogo +30°", "-30": "Análogo −30°",
    60: "Diada 60°",
    120: "Triada 120°", 240: "Triada 240°",
    150: "Comp. dividido 150°", 210: "Comp. dividido 210°",
    180: "Complemento 180°",
  };

  const ROLES = [
    { ho: null, hd: 0 },
    { ho: null, hd: 120 },
    { ho: 210,  hd: 0 },
    { ho: 45,   hd: 0 },
    { ho: 0,    hd: 0 },
    { ho: 120,  hd: 0 },
  ];

  const OFFS = [45, 35, 25, 15, 5, -5, -15, -25, -35, -45];

  function roleH(h, s, l, role) {
    return { h: role.ho !== null ? role.ho : (h + role.hd) % 360, s, l };
  }

  function shades(bh, bs, bl) {
    return OFFS.map((o) => {
      let nl = Math.max(3, Math.min(97, Math.round(bl + o)));
      let ns = bs;
      if (o > 0) ns = Math.round(bs * (1 - (o / 50) * 0.55));
      else if (o < 0) ns = Math.min(100, Math.round(bs * (1 + (Math.abs(o) / 50) * 0.25)));
      return { o, h: bh, s: ns, l: nl };
    });
  }

  function contrast(r, g, b) {
    return (0.299 * r + 0.587 * g + 0.114 * b) > 150 ? "#1a1a1a" : "#ffffff";
  }

  function getBaseColor(sh, role, offsetIdx) {
    const shade = sh[offsetIdx];
    const rh = roleH(shade.h, shade.s, shade.l, role);
    const rgb = hslToRgb(rh.h, rh.s, rh.l);
    return hx(rgb.r, rgb.g, rgb.b);
  }

