        </button>
        <button class="export-opt" data-fmt="tailwind">
          <svg class="export-opt-icon" viewBox="0 0 24 24" fill="none"><path d="M12 4C7.5 4 5 7 5 9s2.5 4 5 4c-2 0-3.5 2-3.5 4s2 3 5 3c4.5 0 7-3 7-5s-2.5-4-5-4c2 0 3.5-2 3.5-4S15.5 4 12 4z" stroke="currentColor" stroke-width="1.5"/></svg>
          <span class="export-opt-title">Tailwind</span>
          <span class="export-opt-sub">Config</span>
        </button>
        <button class="export-opt" data-fmt="png">
