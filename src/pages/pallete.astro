          <span id="dropdown-sub" class="dropdown-sub">Plantilla de restaurante</span>
          <svg class="dropdown-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div id="dropdown-panel" class="dropdown-panel hidden">
          <div class="dropdown-option active" data-idx="0">
            <span class="do-title">Brasa</span>
            <span class="do-sub">Plantilla de restaurante</span>
          </div>
          <div class="dropdown-option" data-idx="1">
            <span class="do-title">Surco</span>
            <span class="do-sub">Plantilla de discos usados</span>
          </div>
          <div class="dropdown-option" data-idx="2">
            <span class="do-title">Guardia</span>
            <span class="do-sub">Plantilla de gestión de incidentes</span>
          </div>
          <div class="dropdown-option" data-idx="3">
            <span class="do-title">Bitácora</span>
            <span class="do-sub">Plantilla de blog</span>
          </div>
          <div class="dropdown-option" data-idx="4">
            <span class="do-title">Índice</span>
            <span class="do-sub">Plantilla de catalogación visual</span>
          </div>
          <div class="dropdown-option" data-idx="5">
