.ticket-code{font-family:'IBM Plex Mono',monospace;font-size:0.7rem;color:var(--ink-soft)}
.ticket-status{font-family:'IBM Plex Mono',monospace;font-size:0.7rem;font-weight:600;letter-spacing:0.04em;padding:3px 9px;border-radius:999px;color:#fff}
.ticket.info .ticket-status{background:var(--info)}
.ticket.warning .ticket-status{background:var(--warning)}
.ticket.error .ticket-status{background:var(--error)}
.ticket.success .ticket-status{background:var(--success)}
.ticket-title{font-family:'Newsreader',serif;font-weight:500;font-size:1.15rem}
