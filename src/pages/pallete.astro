    </div>
  </div>
  <div id="export-overlay" class="export-overlay hidden">
    <div class="export-modal">
      <div class="export-head">
        <button id="export-back" class="export-back hidden">←</button>
        <span class="export-title">Exportar paleta</span>
        <button id="export-close" class="export-close">✕</button>
      </div>
      <div id="export-grid" class="export-grid">
        <button class="export-opt" data-fmt="css">
          <svg class="export-opt-icon" viewBox="0 0 24 24" fill="none"><rect x="4" y="4" width="16" height="16" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M9 10l-2 2 2 2M15 10l2 2-2 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          <span class="export-opt-title">CSS</span>
