  function resolveColor(base, roleColors, suggestions) {
    if (base === "primary") return roleColors[0];
    if (base === "secondary") return roleColors[1];
    if (base === "info") return roleColors[2];
    if (base === "warning") return roleColors[3];
    if (base === "error") return roleColors[4];
    if (base === "success") return roleColors[5];
    if (base === "bgLight") return suggestions.bgLight;
    if (base === "textLight") return suggestions.textLight;
    if (base === "bgDark") return suggestions.bgDark;
    if (base === "textDark") return suggestions.textDark;
    return base;
  }

  function renderPreview(tplIdx, roleColors, suggestions) {
    const tpl = TEMPLATES[tplIdx];
    if (!tpl) return;
    let html = tpl.html;
    for (const rule of tpl.vars) {
      let color = resolveColor(rule.color, roleColors, suggestions);
      if (rule.light) color = lighten(color, rule.light);
      if (rule.dark) color = darken(color, rule.dark);
      if (rule.alpha !== undefined) color = toRgba(color, rule.alpha);
      const pattern = "var(" + rule.var + ")";
