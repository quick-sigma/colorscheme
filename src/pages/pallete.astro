        </button>
        <div id="sec-panel" class="sec-dropdown hidden"></div>
      </div>
      <div class="pal-input-wrap">
        <input id="color-input" type="color" value="#ff0000">
        <input id="color-hex" type="text" value="#FF0000" maxlength="7">
        <button id="generate-btn">Generar paleta</button>
        <button id="export-btn" class="export-btn">Exportar paleta</button>
      </div>
    </div>
    <div class="resizer" id="resizer"></div>
    <div class="pal-right">
      <div class="preview-toolbar">
