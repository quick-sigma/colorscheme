.t-display{font-family:'Newsreader',serif;font-style:italic;font-weight:500;font-size:2.6rem}
.t-h1{font-family:'Newsreader',serif;font-weight:500;font-size:2rem}
.t-h2{font-family:'Newsreader',serif;font-weight:500;font-size:1.5rem}
.t-body{font-family:'Inter',sans-serif;font-size:1rem;line-height:1.5;max-width:60ch}
