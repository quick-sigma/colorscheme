---
export interface Props {
  title?: string;
  backHref?: string;
  nextHref?: string;
}

const { title = "Color Scheme", backHref, nextHref } = Astro.props;
const pageTitle = title === "Color Scheme" ? "Color Scheme" : `${title} - Color Scheme`;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lobster&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="container">
      <div class="header-row">
        <div class="header-left">
          {backHref && (
            <a href={backHref} class="back-btn" aria-label="Volver">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 12H5" />
                <polyline points="12 19 5 12 12 5" />
              </svg>
            </a>
          )}
        </div>
        <h1 class="title">Color Scheme</h1>
        <div class="header-right">
          {nextHref && (
            <a href={nextHref} class="next-btn" id="next-btn">
              Siguiente
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6" />
              </svg>
            </a>
          )}
        </div>
      </div>
      <div class="content">
        <slot />
      </div>
    </div>
  </body>
</html>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html,
  body {
    height: 100%;
  }

  body {
    font-family: "Inter", system-ui, sans-serif;
    background: #0f0f11;
    background-image: radial-gradient(ellipse at 50% 0%, rgba(99, 102, 241, 0.08) 0%, transparent 60%),
      radial-gradient(ellipse at 50% 100%, rgba(168, 85, 247, 0.06) 0%, transparent 60%);
    color: #ffffff;
  }

  .container {
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100vh;
    padding: 2.5rem 2rem 2rem;
  }

  .header-row {
    display: flex;
    align-items: center;
    width: 100%;
    padding-top: 2rem;
  }

  .header-left,
  .header-right {
    flex: 1;
    display: flex;
  }

  .header-left {
    justify-content: flex-start;
  }

  .header-right {
    justify-content: flex-end;
  }

  .back-btn {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }

  .back-btn:hover {
    background: rgba(255, 255, 255, 0.14);
    color: #ffffff;
  }

  .title {
    font-family: "Lobster", cursive;
    font-size: 4rem;
    font-weight: 400;
    color: #ffffff;
    letter-spacing: 0.02em;
    text-shadow: 0 2px 20px rgba(99, 102, 241, 0.3);
    user-select: none;
    flex-shrink: 0;
  }

  .content {
    flex: 1;
    min-height: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .hidden {
    display: none !important;
  }

  .next-btn {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 1.2rem;
    border-radius: 10px;
    background: linear-gradient(135deg, #6366f1, #a855f7);
    color: #fff;
    font-family: "Inter", system-ui, sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 16px rgba(99, 102, 241, 0.35);
    cursor: pointer;
    border: none;
    white-space: nowrap;
  }

  .next-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 24px rgba(99, 102, 241, 0.5);
  }

  .next-btn:active {
    transform: translateY(0);
  }

  .next-btn.disabled {
    opacity: 0.35;
    pointer-events: none;
    box-shadow: none;
  }
</style>
